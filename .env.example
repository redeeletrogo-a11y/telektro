# Web (public values are exposed to the browser; never put service role keys here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OCPP_GATEWAY_BASE_URL=wss://your-gateway.fly.dev

# OCPP Gateway (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OCPP_GATEWAY_PORT=9000
OCPP_ALLOWED_ORIGINS=
OCPP_HEARTBEAT_INTERVAL_SECONDS=60
OCPP_CHARGER_STALE_AFTER_SECONDS=180
OCPP_OPERATION_CONFIRMATION_SECONDS=300
# Local simulator authentication only; ignored in production.
OCPP_DEV_TOKEN=replace-with-a-long-random-value

# Mercado Pago (server-side only, except the public key)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_ELETROPOSTO_ACCESS_TOKEN=
MERCADOPAGO_ELETROPOSTO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_ELETROPOSTO_PUBLIC_KEY=

# Mercado Pago Marketplace OAuth + Split 1:1 (owner receives directly)
MERCADOPAGO_MARKETPLACE_CLIENT_ID=
MERCADOPAGO_MARKETPLACE_CLIENT_SECRET=
# Generate a long random value (example: openssl rand -hex 32). It encrypts seller tokens and signs OAuth state.
MERCADOPAGO_OAUTH_TOKEN_SECRET=
