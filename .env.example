# Web (public values are exposed to the browser; never put service role keys here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OCPP Gateway (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OCPP_GATEWAY_PORT=9000
OCPP_ALLOWED_ORIGINS=
OCPP_HEARTBEAT_INTERVAL_SECONDS=60
# Local simulator authentication only; ignored in production.
OCPP_DEV_TOKEN=replace-with-a-long-random-value
